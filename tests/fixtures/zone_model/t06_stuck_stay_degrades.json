    },
    {
      "at": "2026-07-18T17:30:02Z",
      "active_changes": {},
      "arrival_events": [],
      "health_changes": {
        "room": false
      },
      "reason": "held_stay_saturates"
    },
    {
      "at": "2026-07-18T19:00:00Z",
      "active_changes": {},
      "arrival_events": [],
      "health_changes": {
        "room": false
      },
      "reason": "held_stay_remains_active"
