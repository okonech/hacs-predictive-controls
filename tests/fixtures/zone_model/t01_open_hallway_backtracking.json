    {
      "at": "2026-07-18T12:00:25Z",
      "active_changes": {
        "room_b": true
      },
      "arrival_events": [
        {
          "zone": "room_b",
          "event_type": "acquired"
        }
      ],
      "health_changes": {},
      "reason": "open_transition_distinct_target"
    },
    {
      "at": "2026-07-18T12:02:00Z",
      "active_changes": {
        "room_a": false
      },
      "arrival_events": [],
      "health_changes": {},
      "reason": "departure_conditioned_belief_release"
    }
  ],
  "expected_reason_classes": [
    "transition_context_only",
    "adjacent_transition_arrival",
    "open_transition_distinct_target",
    "departure_conditioned_belief_release"
